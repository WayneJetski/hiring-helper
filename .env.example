# BambooHR Configuration
BAMBOOHR_API_KEY=your_api_key_here
BAMBOOHR_SUBDOMAIN=your_company_subdomain

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# AI scoring
# No LLM provider key is needed. Candidate scoring is done by Claude through the
# MCP server (see MCP.md). Only the BambooHR credentials above are required.
# Model for web-triggered scoring runs (headless Claude Code). Defaults to claude-sonnet-5-5.
# SCORING_MODEL=claude-sonnet-5-5
